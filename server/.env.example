# Copy to .env (or set these in cPanel > Setup Node.js App > Environment variables)
PORT=3000
# Public URL of the site, used for CORS
CORS_ORIGIN=https://ecolift.ge
# URL prefix the app is mounted at in cPanel ("Application URL"), e.g. /api -> leave empty if the app sits on its own subdomain
BASE_PATH=/api

DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_ecolift
DB_PASSWORD=change-me
DB_NAME=cpaneluser_ecolift

# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me

# Mailbox created in cPanel > Email Accounts
SMTP_HOST=mail.ecolift.ge
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@ecolift.ge
SMTP_PASSWORD=change-me
MAIL_FROM="Ecolift <orders@ecolift.ge>"
# Where new orders are sent
OWNER_EMAIL=info@ecolift.ge
