# Angular SPA routing for cPanel (Apache).
# Real files and the Node.js API under /api are served as-is;
# every other path falls back to index.html so routes like /parts/12 work on refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^api(/|$) - [L]
  # Ready-made copies of the public pages (made by scripts/prerender.mjs), so
  # Google reads their text without running Angular. Angular starts on top.
  # If a copy is missing, the normal index.html below still serves the page.
  RewriteCond %{DOCUMENT_ROOT}/prerender/index.html -f
  RewriteRule ^$ prerender/index.html [L]
  RewriteCond %{DOCUMENT_ROOT}/prerender/$1.html -f
  RewriteRule ^([A-Za-z0-9_-]+)/?$ prerender/$1.html [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# The HTML pages and the translation files have fixed names, so browsers must
# re-check them on every visit; otherwise a new deploy stays invisible.
# The hashed .js/.css bundles change name on every build and can be cached.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# The host runs LiteSpeed, whose page cache kept serving an old index.html for "/"
# after a deploy. This is a static Angular app, so skip that cache entirely.
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>
