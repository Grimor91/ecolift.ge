# Angular SPA routing for cPanel (Apache).
# Real files and the Node.js API under /api are served as-is;
# every other path falls back to index.html so routes like /parts/12 work on refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One address per page, so Google doesn't pick its own canonical among copies:
  # http -> https and www.ecolift.ge -> ecolift.ge. The SSL certificate's
  # renewal checks under .well-known/ are left alone.
  RewriteRule ^\.well-known/ - [L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://ecolift.ge%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://ecolift.ge%{REQUEST_URI} [R=301,L]

  RewriteRule ^api(/|$) - [L]

  # /index.html -> /, /lifts/ -> /lifts, ?lang=ka -> plain address (Georgian is the default).
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ https://ecolift.ge/ [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://ecolift.ge/$1 [R=301,L]
  RewriteCond %{QUERY_STRING} ^lang=ka$
  RewriteRule ^(.*)$ https://ecolift.ge/$1? [R=301,L]

  # Parts and articles come from the database; the API server keeps a copy of each
  # of their pages in pages/<language>/ (server/services/pages.js).
  RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
  RewriteCond %{DOCUMENT_ROOT}/pages/en/$1.html -f
  RewriteRule ^((parts|articles)(/[A-Za-z0-9_-]+)?)$ pages/en/$1.html [L]
  RewriteCond %{QUERY_STRING} (^|&)lang=ru(&|$)
  RewriteCond %{DOCUMENT_ROOT}/pages/ru/$1.html -f
  RewriteRule ^((parts|articles)(/[A-Za-z0-9_-]+)?)$ pages/ru/$1.html [L]
  RewriteCond %{QUERY_STRING} !(^|&)lang=(en|ru)(&|$)
  RewriteCond %{DOCUMENT_ROOT}/pages/ka/$1.html -f
  RewriteRule ^((parts|articles)(/[A-Za-z0-9_-]+)?)$ pages/ka/$1.html [L]

  # Ready-made copies of the public pages (made by scripts/prerender.mjs), so
  # Google reads their text without running Angular. Angular starts on top.
  # If a copy is missing, the normal index.html below still serves the page.
  # English and Russian copies for ?lang=en and ?lang=ru (one block per language).
  RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
  RewriteCond %{DOCUMENT_ROOT}/prerender/en/index.html -f
  RewriteRule ^$ prerender/en/index.html [L]
  RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
  RewriteCond %{DOCUMENT_ROOT}/prerender/en/$1.html -f
  RewriteRule ^([A-Za-z0-9_-]+)/?$ prerender/en/$1.html [L]
  RewriteCond %{QUERY_STRING} (^|&)lang=ru(&|$)
  RewriteCond %{DOCUMENT_ROOT}/prerender/ru/index.html -f
  RewriteRule ^$ prerender/ru/index.html [L]
  RewriteCond %{QUERY_STRING} (^|&)lang=ru(&|$)
  RewriteCond %{DOCUMENT_ROOT}/prerender/ru/$1.html -f
  RewriteRule ^([A-Za-z0-9_-]+)/?$ prerender/ru/$1.html [L]
  RewriteCond %{DOCUMENT_ROOT}/prerender/index.html -f
  RewriteRule ^$ prerender/index.html [L]
  RewriteCond %{DOCUMENT_ROOT}/prerender/$1.html -f
  RewriteRule ^([A-Za-z0-9_-]+)/?$ prerender/$1.html [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# The HTML pages and the translation files have fixed names, so browsers must
# re-check them on every visit; otherwise a new deploy stays invisible.
# The hashed .js/.css bundles change name on every build and can be cached.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Security headers (checked with securityheaders.com).
# The Content-Security-Policy lists every outside address the site really uses:
#   styles/fonts: Google Fonts, Font Awesome (cdnjs + pro.fontawesome.com), flag icons (jsdelivr)
#   scripts: Google Maps on /aboutus (maps.googleapis.com, maps.gstatic.com)
#   frames: the YouTube video on the home page, LinkedIn posts on /news, Google Maps
#   images: any https address (map tiles, country flags in the admin panel, LinkedIn)
# 'unsafe-inline' stays for scripts and styles: Angular's build loads its CSS with an
# inline onload="" and adds component styles at runtime; Google Maps needs 'unsafe-eval'.
# When adding a new outside service (chat widget, analytics...), add its address here.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://pro.fontawesome.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://pro.fontawesome.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://maps.googleapis.com https://*.googleapis.com https://maps.gstatic.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.linkedin.com https://www.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always unset X-Powered-By
</IfModule>

# Never serve hidden files (.env, .git, .htpasswd...) or backups/dumps if one is ever uploaded here.
<FilesMatch "^\.|\.(sql|bak|env|log|zip|tar|gz)$">
  Require all denied
</FilesMatch>

# The host runs LiteSpeed, whose page cache kept serving an old index.html for "/"
# after a deploy. This is a static Angular app, so skip that cache entirely.
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>
